NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production for canonical middleware redirects; keep server-only.
APP_URL=

# Phase 1 MySQL foundation. These are server-only and are not consumed until
# a later data-path cutover. Do not use NEXT_PUBLIC_ prefixes for these values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=
LOCAL_AI_BASE_URL=
AI_TIMEOUT_MS=20000

# Optional task overrides; each falls back to AI_MODEL.
AI_LESSON_MODEL=
AI_CONVERSATION_MODEL=
AI_ANALYSIS_MODEL=

# Future server-side Better Auth configuration.
# Generate a unique secret; never commit its actual value.
BETTER_AUTH_SECRET=
